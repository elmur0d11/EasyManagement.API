{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/applogs-.txt",
          "rollingInterval": "Day"
        }
      } 
      ],
    "Enrich": ["FromLogContext", "WithThreadId", "WithMachineName"]
  },
  "AppSettings": {
    "Token": "8TLLHyQQTksQ0aHtTph5vZludPyQe2sOf6bXfsStzty07tuhpvwZKGpQJ1p6yRo6",
    "Issuer": "EasyManageApi",
    "Audience": "EasyManageUser"  
  }
}
